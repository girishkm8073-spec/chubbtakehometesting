# Copy to .env and adjust. Every environment-specific value the suite uses lives here —
# nothing host-, port- or credential-related is hard-coded in test code.

# --- Application endpoints (docker-compose.apps.yml defaults) ---
UI_BASE_URL=http://localhost:3001
BFF_BASE_URL=http://localhost:8090
CLAIMS_SERVICE_BASE_URL=http://localhost:8080
BFF_WS_URL=ws://localhost:8090/api/ws/claims

# --- Seeded test users (from docker/compose/keycloak/demo-app-realm.json, documented in the app README) ---
ADMIN_EMAIL=admin@demo.com
ADMIN_PASSWORD=Admin123!
CLAIMANT_EMAIL=claimant@demo.com
CLAIMANT_PASSWORD=Claimant123!

# Password used for throw-away claimants created by the suite via /api/auth/signup
GENERATED_USER_PASSWORD=QaAutomation123!

# --- Paths to the API contracts under test (relative to qa-tests/) ---
BFF_OPENAPI_SPEC=../demo-app-qa-main/code/bff-service/src/main/resources/openapi/bff-api.yml
CLAIM_EVENT_SCHEMA_DIR=../demo-app-qa-main/code/claims-service/src/main/resources/asyncapi/schemas

# --- Kafka (host-facing listener from docker-compose.infra.yml) ---
KAFKA_BROKERS=localhost:9092
KAFKA_CLAIM_EVENTS_TOPIC=claim-events

# --- Clock ---
# Must match the claims-service container (eclipse-temurin alpine images run in UTC).
# Used for "today"-relative test dates AND as the browser timezone, so date assertions are deterministic.
# Timezone-dependent UI behaviour (DEF-015) is covered by changing this deliberately, not by accident.
TEST_TIMEZONE=UTC

# --- Timeouts (ms) ---
REALTIME_EVENT_TIMEOUT_MS=15000
